# Proyecto Dokploy `clubify-media` → Environment.

# --- Obligatorio ---
# ⚠ MISMOS valores que en clubify-api / clubify-chat.
POSTGRES_PASSWORD=
JWT_SECRET=

# Hetzner Object Storage (access key de project, no de root)
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=clubify-media
S3_REGION=fsn1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ⚠ Pull zone REAL de Bunny: con el default roto las imágenes salen rotas.
BUNNY_CDN_URL=https://clubify-media.b-cdn.net

# --- Límites (por defecto en el compose) ---
#TRAFFIC_MAX_DAILY_BYTES=107374182400
#TRAFFIC_MAX_MONTHLY_BYTES=2199023255552
#TRAFFIC_MAX_DAILY_DOWNLOADS=50000
#TRAFFIC_MAX_USER_DAILY_BYTES=10737418240
#TRAFFIC_MAX_USER_DAILY_DOWNLOADS=500
#TRAFFIC_MAX_REQUESTS_PER_HOUR=5000
#RUST_LOG=info
#MEDIA_PORT=3004
