# =============================================================================
# Clubify · MEDIA-GATEWAY — Variables de entorno para DEPLOY (Dokploy)
# =============================================================================
# ⚠ TODAS las variables son OBLIGATORIAS. No hay defaults.
#   Si falta alguna, el servicio NO arrancará.
# =============================================================================

# =============================================================================
# RED
# =============================================================================

# Interfaz donde escucha el servicio.
# Dentro de Docker: 0.0.0.0
# Fuera de Docker: 127.0.0.1
HOST=

# Puerto interno del servicio (3004, no 3003: el 3003 lo usa la API).
PORT=

# [SEGURIDAD] Dirección de binding del puerto en el HOST.
# Producción: 127.0.0.1 (solo accesible vía Traefik)
# Desarrollo: 0.0.0.0 (accesible desde la red)
BIND_ADDRESS=

# Nivel de logs (formato tracing).
RUST_LOG=

# =============================================================================
# DATOS
# =============================================================================

# URL completa de PostgreSQL (base de datos SEPARADA para no cargar la principal).
# Formato: postgres://usuario:password@host:puerto/basedatos
DATABASE_URL=

# URL de Redis.
# Formato: redis://host:puerto
REDIS_URL=

# =============================================================================
# SEGURIDAD
# =============================================================================

# Secreto JWT (DEBE coincidir con el backend principal).
JWT_SECRET=

# =============================================================================
# S3 (HETZNER OBJECT STORAGE)
# =============================================================================

# Endpoint de S3.
# Ejemplo: https://fsn1.your-objectstorage.com
S3_ENDPOINT=

# Nombre del bucket.
S3_BUCKET=

# Región de S3.
# Ejemplo: fsn1
S3_REGION=

# Credenciales de acceso a S3.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =============================================================================
# CDN
# =============================================================================

# Bunny.net CDN URL para generar URLs públicas.
# Ejemplo: https://clubify-media.b-cdn.net
BUNNY_CDN_URL=

# =============================================================================
# LÍMITES DE TRÁFICO
# =============================================================================

# Máximo de bytes diarios totales.
# Ejemplo: 107374182400 (100 GB)
TRAFFIC_MAX_DAILY_BYTES=

# Máximo de bytes mensuales totales.
# Ejemplo: 2199023255552 (2 TB)
TRAFFIC_MAX_MONTHLY_BYTES=

# Máximo de descargas diarias totales.
TRAFFIC_MAX_DAILY_DOWNLOADS=

# Máximo de bytes diarios por usuario.
# Ejemplo: 10737418240 (10 GB)
TRAFFIC_MAX_USER_DAILY_BYTES=

# Máximo de descargas diarias por usuario.
TRAFFIC_MAX_USER_DAILY_DOWNLOADS=

# Máximo de peticiones por hora por usuario.
TRAFFIC_MAX_REQUESTS_PER_HOUR=

# =============================================================================
# VIDEO PROCESSING
# =============================================================================

# Habilitar procesamiento de video. true o false.
VIDEO_PROCESSING_ENABLED=

# Tamaño máximo de upload de video en bytes.
# Ejemplo: 524288000 (500 MB)
VIDEO_MAX_UPLOAD_SIZE=

# Calidades de video a generar (separadas por coma).
# Ejemplo: 360p,720p,1080p
VIDEO_QUALITIES=
