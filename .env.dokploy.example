# Variables de entorno para Dokploy
# Copia y pega estas variables en el panel de Dokploy (Environment)
# Reemplaza los valores con tus credenciales reales

# ============================================
# CONEXIONES (OBLIGATORIAS)
# ============================================

# PostgreSQL (red clubify-internal)
DATABASE_URL=postgres://clubify:***:5432/media_gateway

# Redis (red clubify-internal)
REDIS_URL=redis://redis:6379

# JWT (DEBE ser idéntico al backend principal)
JWT_SECRET=***

# ============================================
# HETZNER OBJECT STORAGE (OBLIGATORIAS)
# ============================================

S3_ENDPOINT=***
S3_BUCKET=***
S3_REGION=***
S3_ACCESS_KEY=***
S3_SECRET_KEY=***

# ============================================
# BUNNY CDN (OBLIGATORIA)
# ============================================

BUNNY_CDN_URL=***

# ============================================
# SERVIDOR (OPCIONALES - CON DEFAULTS)
# ============================================

HOST=0.0.0.0
PORT=3004
RUST_LOG=info

# ============================================
# LÍMITES DE TRÁFICO (OPCIONALES)
# ============================================

# 100 GB/día
TRAFFIC_MAX_DAILY_BYTES=107374182400
# 2 TB/mes
TRAFFIC_MAX_MONTHLY_BYTES=2199023255552
TRAFFIC_MAX_DAILY_DOWNLOADS=50000
# 10 GB/día/usuario
TRAFFIC_MAX_USER_DAILY_BYTES=10737418240
TRAFFIC_MAX_USER_DAILY_DOWNLOADS=500
TRAFFIC_MAX_REQUESTS_PER_HOUR=5000

# ============================================
# VIDEO PROCESSING (PENDIENTE - OFF)
# ============================================

VIDEO_PROCESSING_ENABLED=false
VIDEO_MAX_UPLOAD_SIZE=524288000
VIDEO_QUALITIES=360p,720p,1080p
