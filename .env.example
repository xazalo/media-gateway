# Servidor
HOST=0.0.0.0
PORT=3003
RUST_LOG=info

# PostgreSQL (base de datos SEPARADA para no cargar la principal)
DATABASE_URL=postgres://clubify:password@localhost:5432/media_gateway

# Redis
REDIS_URL=redis://localhost:6379

# JWT (DEBE coincidir con el backend principal de Clubify)
JWT_SECRET=***

# Hetzner Object Storage
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=clubify-media
S3_REGION=fsn1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Bunny.net CDN (para generar URLs)
BUNNY_CDN_URL=https://clubify-media.b-cdn.net

# Límites de tráfico
TRAFFIC_MAX_DAILY_BYTES=107374182400
TRAFFIC_MAX_MONTHLY_BYTES=2199023255552
TRAFFIC_MAX_DAILY_DOWNLOADS=50000
TRAFFIC_MAX_USER_DAILY_BYTES=10737418240
TRAFFIC_MAX_USER_DAILY_DOWNLOADS=500
TRAFFIC_MAX_REQUESTS_PER_HOUR=5000

# Video processing (pendiente de implementar)
VIDEO_PROCESSING_ENABLED=false
VIDEO_MAX_UPLOAD_SIZE=524288000
VIDEO_QUALITIES=360p,720p,1080p
